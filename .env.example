# Local dev (relative to backend cwd): sqlite+aiosqlite:///./data/tradeonbu.db
# Docker (absolute volume path — set by compose):
DATABASE_URL=sqlite+aiosqlite:////app/data/tradeonbu.db
DEFAULT_SYMBOL=BTCUSDT

# Paper only — no Bitunix trading keys required
TAKER_FEE_RATE=0.0006
MAKER_FEE_RATE=0.0002

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUIRE_APPROVAL=true
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_SECRET=
DASHBOARD_PUBLIC_URL=https://your-domain.example

DASHBOARD_API_KEY=change-me-dashboard
ADMIN_API_KEY=change-me-admin
CORS_ALLOWED_ORIGINS=https://your-domain.example,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120

SCAN_INTERVAL_SECONDS=300

# Source of AI inference: siwc (ChatGPT subscription) or openai_api (billed separately).
# API mode always requests gpt-6-luna with reasoning=high.
AI_PROVIDER=siwc
OPENAI_API_KEY=
